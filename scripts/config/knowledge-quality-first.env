# Shared release policy: accuracy before latency/token savings.
RETRIEVAL_QUALITY_PROFILE=quality-first
RLS_ENFORCE=1
CORE_AUTH_ENFORCE=1
CORE_VERSIONING_ENABLED=1
CORE_GRAPH_INCREMENTAL_ENABLED=1
ADAPTIVE_RETRIEVAL_ENABLED=true
# Current providers cannot supply these representations; user excluded them.
BGE_M3_HYBRID_ENABLED=false
BGE_M3_MAXSIM_ENABLED=false
BGE_M3_LATE_CHUNKING_ENABLED=false
# Hosted dense API exposes no immutable weights revision; never invent one.
ALLOW_UNVERSIONED_EMBEDDING_PUBLICATION=true
