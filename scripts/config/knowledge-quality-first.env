# Shared release policy: accuracy before latency/token savings.
RETRIEVAL_QUALITY_PROFILE=quality-first
RLS_ENFORCE=1
CORE_AUTH_ENFORCE=1
CORE_VERSIONING_ENABLED=1
CORE_GRAPH_INCREMENTAL_ENABLED=1
ADAPTIVE_RETRIEVAL_ENABLED=true
# Current providers cannot supply these representations; user excluded them.
BGE_M3_HYBRID_ENABLED=false
BGE_M3_MAXSIM_ENABLED=false
BGE_M3_LATE_CHUNKING_ENABLED=false
# Hosted dense API exposes no immutable weights revision; never invent one.
ALLOW_UNVERSIONED_EMBEDDING_PUBLICATION=true
# Any single GBrain CLI subprocess (sync excluded, it has its own budget) must
# die well before the ~200s query deadline (25s: two capped engine: a runaway child otherwise starves
# the pool and the whole request dies at the deadline (prod inst2, 2026-10-01).
GBRAIN_COMMAND_TIMEOUT_MS=10000

# The unified planner LLM call currently never answers in time on prod;
# 8s keeps its budget slice small and the deterministic fallback starts sooner.
AGENTIC_PLAN_TIMEOUT_MS=8000
