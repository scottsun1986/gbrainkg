[Unit]
Description=LLMWiki API
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/gbrainkg/apps/api
EnvironmentFile=%h/.config/llmwiki/production.env
ExecStart=%h/.local/bin/node %h/gbrainkg/apps/api/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=15

# Limits and Logging
MemoryMax=2G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
