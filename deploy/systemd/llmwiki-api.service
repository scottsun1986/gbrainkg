[Unit]
Description=LLMWiki API
After=network.target
Wants=llmwiki-parser.service

[Service]
Type=simple
WorkingDirectory=%h/gbrainkg/apps/api
EnvironmentFile=%h/gbrainkg/apps/api/.env
Environment=GBRAIN_POOL_SIZE=2
Environment=PATH=%h/.bun/bin:%h/.local/bin:%h/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/node %h/gbrainkg/apps/api/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=15

# Limits and Logging
MemoryMax=2G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
