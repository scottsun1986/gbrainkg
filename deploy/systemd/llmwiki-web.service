[Unit]
Description=LLMWiki Web
After=network.target llmwiki-api.service

[Service]
Type=simple
WorkingDirectory=%h/gbrainkg/apps/web
Environment=PORT=3200
Environment=HOSTNAME=0.0.0.0
ExecStart=%h/.local/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=15

# Limits and Logging
MemoryMax=1G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
