[Unit]
Description=LLMWiki Parser Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/gbrainkg/apps/parser-worker
EnvironmentFile=%h/.config/llmwiki/production.env
ExecStart=/usr/bin/python3 -m uvicorn src.main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=5
TimeoutStopSec=15

# Limits and Logging
MemoryMax=4G
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
