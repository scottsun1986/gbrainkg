[Unit]
Description=LLMWiki Parser Worker
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/scottsun/gbrainkg/apps/parser-worker
ExecStart=/usr/bin/python3 -m uvicorn src.main:app --host 0.0.0.0 --port 8100
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
