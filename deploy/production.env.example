# Copy to the repository root as .env, or let deploy/install.sh create it.
# This file must never contain demo credentials or be committed to Git.

DB_USER=llmwiki
DB_PASS=replace-with-a-long-random-database-password
DB_NAME=llmwiki

REDIS_PASS=replace-with-a-long-random-redis-password
MINIO_USER=llmwiki-minio
MINIO_PASS=replace-with-a-long-random-minio-password

AUTH_SECRET=replace-with-a-long-random-auth-secret
MODEL_CONFIG_KEY=replace-with-a-different-long-random-model-config-key
PARSER_AUTH_TOKEN=replace-with-a-long-random-parser-token

# The install script stores the initial admin password in this Docker secret
# file. Do not put the password in this env file.
ADMIN_EMAIL=admin@local.invalid

# External providers are intentionally empty on a clean install. Configure
# them later from the admin UI, where credentials are encrypted in PostgreSQL.
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=

GBRAIN_VERSION=0.47.6.0
GBRAIN_MAINTENANCE_ENABLED=1
GBRAIN_MAINTENANCE_TZ=Asia/Shanghai
GBRAIN_MAINTENANCE_CRON=0 2 * * *
ACCESS_RECONCILE_INTERVAL_MS=900000
INGESTION_CONCURRENCY=2
PDF_PARSE_MODE=quality
DOCLING_TIMEOUT_SECONDS=240

WEB_ORIGIN=http://localhost:20080
# Host port exposed by Nginx. Production deployments must use a high port.
HTTP_PORT=20080
LLMWIKI_IMAGE_TAG=local
