# Copy to the repository root as .env, or let deploy/install.sh create it.
# This file must never contain demo credentials or be committed to Git.

DB_USER=llmwiki
DB_PASS=replace-with-a-long-random-database-password
DB_NAME=llmwiki
# Migration / GBrain role (BYPASSRLS). GBrain migrations require BYPASSRLS.
DATABASE_URL=postgresql://llmwiki:replace-with-a-long-random-database-password@127.0.0.1:5432/llmwiki?schema=public
GBRAIN_DATABASE_URL=postgresql://llmwiki:replace-with-a-long-random-database-password@127.0.0.1:5432/llmwiki?schema=public

# Runtime role (NOBYPASSRLS) — the API should connect with this DSN so Row
# Level Security actually enforces tenant isolation. The migration/GBrain role
# above keeps BYPASSRLS and must NOT be used for request-path queries.
#   CREATE USER llmwiki_app WITH PASSWORD '<unique-random>' NOBYPASSRLS;
#   GRANT CONNECT ON DATABASE llmwiki TO llmwiki_app;
#   GRANT USAGE,CREATE ON SCHEMA public TO llmwiki_app;
#   GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO llmwiki_app;
#   GRANT USAGE,SELECT ON ALL SEQUENCES IN SCHEMA public TO llmwiki_app;
DB_USER_APP=llmwiki_app
DB_PASS_APP=replace-with-a-different-long-random-app-password
DATABASE_URL_APP=postgresql://llmwiki_app:replace-with-a-different-long-random-app-password@127.0.0.1:5432/llmwiki?schema=public

# RLS_ENFORCE=1 wraps Prisma queries in transaction-local user/service context.
# API startup rejects a BYPASSRLS role or an app.service=on default. Requires
# DATABASE_URL_APP; migration/GBrain continue using DATABASE_URL.
RLS_ENFORCE=1

REDIS_PASS=replace-with-a-long-random-redis-password
# MinIO / S3-compatible object storage placeholders (replace before use; never
# commit real credentials). Used by apps/api/src/storage/object-storage.service.ts.
MINIO_USER=llmwiki-minio
MINIO_PASS=replace-with-a-long-random-minio-password
# Host/ops view of the S3 endpoint (for mc, scripts). The api container gets
# MINIO_API_ENDPOINT below — never point that at 127.0.0.1 from inside compose.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=replace-with-a-long-random-minio-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret-key
MINIO_BUCKET=llmwiki-raw
MINIO_REGION=us-east-1
# S3 endpoint as seen from inside the compose network (api → minio service).
# A 127.0.0.1 endpoint only works for host-side tools; the api container must
# use the in-network name. Override only when the wiring is non-standard.
MINIO_API_ENDPOINT=http://minio:9000

AUTH_SECRET=replace-with-a-long-random-auth-secret
MODEL_CONFIG_KEY=replace-with-a-different-long-random-model-config-key
PARSER_AUTH_TOKEN=replace-with-a-long-random-parser-token

# ---------------------------------------------------------------------------
# SSO / OIDC (authorization code flow)
# Leave every OIDC_* value empty to disable SSO — password login is unaffected
# and /api/v1/auth/oidc/* returns 404/501-class errors with a clear message.
# ---------------------------------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the redirect URI registered at the IdP (API callback endpoint).
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Where the browser lands after a successful SSO login (defaults to WEB_ORIGIN).
OIDC_POST_LOGIN_REDIRECT=
# Optional explicit endpoints (skips /.well-known/openid-configuration discovery).
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=
# OIDC_USERINFO_ENDPOINT=
# OIDC_JWKS_URI=

# ---------------------------------------------------------------------------
# MFA / TOTP (RFC 6238, HMAC-SHA1). Display name shown in authenticator apps.
# ---------------------------------------------------------------------------
MFA_ISSUER=GBrainKG
# Max password / MFA login attempts per minute per client (shared throttle).
# AUTH_LOGIN_THROTTLE_LIMIT=10

# The install script stores the initial admin password in this Docker secret
# file. Do not put the password in this env file.
ADMIN_EMAIL=admin@local.invalid

# External LLM/embedding providers are intentionally empty on a clean install.
# Configure them later from the admin UI, where credentials are encrypted in
# PostgreSQL. OCR credentials below are read by the parser worker and should
# be kept in this protected .env file (or supplied through a secret manager).
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=

# PDF ingestion route: pypdf for text PDFs; cloud OCR only for scanned/mixed
# PDFs; this production profile does not install local Docling. Set
# OCR_PROVIDER=baidu after configuring the two Baidu credentials for scanned
# or mixed PDFs. Use OCR_PROVIDER=none when documents must never leave the
# server; scanned PDFs will then be reported as failed instead of silently
# losing their text.
PDF_PARSE_MODE=hybrid
LOCAL_DOCLING_ENABLED=0
OCR_PROVIDER=none
OCR_TIMEOUT_SECONDS=900
OCR_POLL_INTERVAL_SECONDS=5
OCR_MAX_FILE_BYTES=52428800
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com
PARSER_POLL_TIMEOUT_MS=900000
# Two independent parser-worker limits: retained result entries (memory) and
# in-flight queued/processing tasks (latency). A task stuck in either state is
# failed after PARSER_TASK_STALE_SECONDS instead of occupying a slot forever.
PARSER_MAX_TASKS=5000
PARSER_MAX_INFLIGHT=64
PARSER_TASK_STALE_SECONDS=5400
# Legacy .doc conversion guard (OLE2 signature is validated before antiword).
LEGACY_WORD_MAX_BYTES=62914560

# Prisma connection pool. The API shares PostgreSQL with the enrichment workers
# and GBrain; without an explicit bound a 2 vCPU instance exhausts the pool
# ("Unable to start a transaction in the given time").
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=20

# GraphRAG tuning (all optional; defaults shown).
GRAPHRAG_COMMUNITY_ALGORITHM=louvain
GRAPHRAG_LOUVAIN_RESOLUTION=1
GRAPHRAG_COMMUNITY_MIN_SIZE=2
GRAPHRAG_ENTITY_RESOLUTION=true
GRAPHRAG_ENTITY_ALIAS_THRESHOLD=0.86
GRAPHRAG_COMMUNITY_SUMMARY_LLM=true
GRAPHRAG_COMMUNITY_HIERARCHY=true
RETRIEVAL_GRAPH_RRF_WEIGHT=0.8

# Contextual Retrieval prefix memo (durable). Retained per last use.
CONTEXTUAL_RETRIEVAL_CACHE_RETENTION_DAYS=90

GBRAIN_VERSION=0.47.6.0
GBRAIN_MAINTENANCE_ENABLED=1
GBRAIN_MAINTENANCE_TZ=Asia/Shanghai
GBRAIN_MAINTENANCE_CRON="0 2 * * *"
# Source freshness runs on the nightly Dream cycle. Permission-scoped
# synthesis is asynchronous and provenance-gated; set 0 only when the LLM
# gateway is intentionally unavailable.
GBRAIN_SCOPE_SYNTHESIZE_ENABLED=1
# Run GBrain's incremental graph/timeline extraction for every Source Dream.
# Unchanged pages are skipped by GBrain; this also bootstraps existing Sources.
GBRAIN_GRAPH_EXTRACT_ENABLED=1
GBRAIN_POOL_SIZE=2
# Optional: set this only after provisioning private Git remotes for every
# GBrain Source. The platform never pushes knowledge to an undeclared remote.
GBRAIN_SOURCE_REMOTE_URL_TEMPLATE=
ACCESS_RECONCILE_INTERVAL_MS=900000

# Retrieval pipeline switches. HyDE adds one LLM call per complex question, so
# it stays off unless explicitly enabled (the legacy HYDE_ENABLED name is still
# honoured as an opt-in, but AGENTIC_HYDE_ENABLED is the canonical switch).
AGENTIC_HYDE_ENABLED=0
# Benchmark-shaped English decomposition patterns (bridge/comparison templates
# modelled on 2Wiki/HotpotQA) are off for production corpora; the evaluation
# scripts turn them on explicitly.
RETRIEVAL_BENCHMARK_PATTERNS=0
# Hard cap for the assembled answer context (tokens). 0 disables the cap.
RETRIEVAL_CONTEXT_TOKEN_HARD_CAP=0
# Preserve one representative per planned sub-question/bridge in multi-hop context.
CHAT_STRUCTURED_EVIDENCE=true
# Optional deployment namespace; answer-pipeline schema invalidation is built in.
SEMANTIC_CACHE_KEY_VERSION=release-2026-09-22
GRAPHRAG_DRIFT_ENABLED=true
GRAPHRAG_DRIFT_MAX_COMMUNITIES=2
GRAPHRAG_DRIFT_MAX_PROBES=2
# BGE-M3 sparse + ColBERT late-interaction arms are ON by default (code default
# is `!== 'false'`). Gateways that only return dense vectors simply leave the
# sparse/late channels empty (fail-open + retrieval_failopen_total{channel="sparse"|
# "late_interaction"}), so enabling is safe. Set BGE_M3_HYBRID_ENABLED=false to
# opt out entirely. Point BGE_M3_HYBRID_ENDPOINT at a gateway implementing the
# BGE-M3 hybrid response contract (see docs/minio-embedding-runbook.md).
BGE_M3_HYBRID_ENABLED=true
BGE_M3_HYBRID_ENDPOINT=
BGE_M3_LATE_CHUNKING=true
BGE_M3_MULTI_VECTOR_MAX_TOKENS=128
RETRIEVAL_BGE_M3_SPARSE_RRF_WEIGHT=0.9
RETRIEVAL_BGE_M3_LATE_RRF_WEIGHT=1.0
INGESTION_CONCURRENCY=2
DOCLING_TIMEOUT_SECONDS=240

WEB_ORIGIN=http://localhost:20080
# Host port exposed by Nginx. Production deployments must use a high port.
HTTP_PORT=20080
LLMWIKI_IMAGE_TAG=local
