# Copy to the repository root as .env, or let deploy/install.sh create it.
# This file must never contain demo credentials or be committed to Git.

DB_USER=llmwiki
DB_PASS=replace-with-a-long-random-database-password
DB_NAME=llmwiki

REDIS_PASS=replace-with-a-long-random-redis-password
MINIO_USER=llmwiki-minio
MINIO_PASS=replace-with-a-long-random-minio-password

AUTH_SECRET=replace-with-a-long-random-auth-secret
MODEL_CONFIG_KEY=replace-with-a-different-long-random-model-config-key
PARSER_AUTH_TOKEN=replace-with-a-long-random-parser-token

# The install script stores the initial admin password in this Docker secret
# file. Do not put the password in this env file.
ADMIN_EMAIL=admin@local.invalid

# External LLM/embedding providers are intentionally empty on a clean install.
# Configure them later from the admin UI, where credentials are encrypted in
# PostgreSQL. OCR credentials below are read by the parser worker and should
# be kept in this protected .env file (or supplied through a secret manager).
LLM_BASE_URL=
LLM_MODEL=
DEEPSEEK_API_KEY=

# PDF ingestion route: pypdf for text PDFs; cloud OCR only for scanned/mixed
# PDFs; this production profile does not install local Docling. Set
# OCR_PROVIDER=baidu after configuring the two Baidu credentials for scanned
# or mixed PDFs. Use OCR_PROVIDER=none when documents must never leave the
# server; scanned PDFs will then be reported as failed instead of silently
# losing their text.
PDF_PARSE_MODE=hybrid
LOCAL_DOCLING_ENABLED=0
OCR_PROVIDER=none
OCR_TIMEOUT_SECONDS=900
OCR_POLL_INTERVAL_SECONDS=5
OCR_MAX_FILE_BYTES=52428800
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com
PARSER_POLL_TIMEOUT_MS=900000

GBRAIN_VERSION=0.47.6.0
GBRAIN_MAINTENANCE_ENABLED=1
GBRAIN_MAINTENANCE_TZ=Asia/Shanghai
GBRAIN_MAINTENANCE_CRON="0 2 * * *"
ACCESS_RECONCILE_INTERVAL_MS=900000
INGESTION_CONCURRENCY=2
DOCLING_TIMEOUT_SECONDS=240

WEB_ORIGIN=http://localhost:20080
# Host port exposed by Nginx. Production deployments must use a high port.
HTTP_PORT=20080
LLMWIKI_IMAGE_TAG=local
