{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    /* Keep the incremental cache inside dist: nest deletes dist before every
       build (deleteOutDir), and a cache left outside it would make tsc believe
       the (now deleted) output is still up to date, silently emitting nothing. */
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  /* `scripts/` holds tsx-run operational tooling. Without this exclusion tsc
     widens rootDir to the package root and emits dist/src/main.js, which the
     systemd units and scripts/deploy-prod.sh do not look at. */
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"]
}
