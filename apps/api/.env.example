DATABASE_URL=postgresql://llmwiki:change-me@localhost:5433/llmwiki
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3001
BRAIN_REPO_BASE_PATH=/var/lib/llmwiki/brain_repos
UPLOAD_ROOT=/var/lib/llmwiki/uploads
PARSER_WORKER_URL=http://parser-worker:8000
# Required before enabling a real external model provider in production.
# 32+ random characters; used for AES-GCM encryption of provider API keys.
MODEL_CONFIG_KEY=replace-with-an-independent-long-random-secret
# Dynamic ACL reconciliation and official GBrain source maintenance.
ACCESS_RECONCILE_INTERVAL_MS=900000
GBRAIN_MAINTENANCE_ENABLED=1
GBRAIN_MAINTENANCE_TZ=Asia/Shanghai
GBRAIN_MAINTENANCE_CRON=0 2 * * *
INGESTION_CONCURRENCY=2
INGESTION_RECOVERY_AFTER_MS=300000
AUTH_SECRET=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
