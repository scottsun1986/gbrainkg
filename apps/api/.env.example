DATABASE_URL=postgresql://llmwiki:change-me@localhost:5433/llmwiki
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3001
BRAIN_REPO_BASE_PATH=/var/lib/llmwiki/brain_repos
UPLOAD_ROOT=/var/lib/llmwiki/uploads
PARSER_WORKER_URL=http://parser-worker:8000
# Required before enabling a real external model provider in production.
# 32+ random characters; used for AES-GCM encryption of provider API keys.
MODEL_CONFIG_KEY=replace-with-an-independent-long-random-secret
# Dynamic ACL reconciliation and official GBrain source maintenance.
ACCESS_RECONCILE_INTERVAL_MS=900000
GBRAIN_MAINTENANCE_ENABLED=1
GBRAIN_MAINTENANCE_TZ=Asia/Shanghai
GBRAIN_MAINTENANCE_CRON=0 2 * * *
INGESTION_CONCURRENCY=2
INGESTION_RECOVERY_AFTER_MS=300000
AUTH_SECRET=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# --- Retrieval: full-corpus BM25 lexical channel (PostgreSQL) ---
# Set to false to fall back to the legacy application-side candidate pool.
LEXICAL_INDEX_ENABLED=true
# Rarest-first cumulative df budget: an upper bound on how many chunks the
# engine-side ranker walks in one pass. Raise it to trade latency for recall.
LEXICAL_CANDIDATE_BUDGET=8000
# Relevance-ordered candidate window that is re-scored with exact BM25.
LEXICAL_CANDIDATE_WINDOW=0
# Skip the engine channel when even the rarest query term occurs in more than
# this share of the corpus (no lexical discrimination to offer).
LEXICAL_MAX_RAREST_DF_RATIO=0.3
# BM25 parameters and statement timeout for the lexical statement.
LEXICAL_BM25_K1=1.2
LEXICAL_BM25_B=0.75
LEXICAL_STATEMENT_TIMEOUT_MS=2500
# Backfill write batch size (see `pnpm --filter api lexical:backfill`).
LEXICAL_INDEX_BATCH=500

# --- Retrieval: filtered HNSW (pgvector) ---
# Raised to 200 together with iterative scan: on a 100k-chunk corpus with a
# 1-of-40-KB filter this is the setting that reaches Recall@10 1.00, while the
# same ef_search without iterative scan drops to 0.45 with 90% short results.
VECTOR_EF_SEARCH=200
VECTOR_ITERATIVE_SCAN=relaxed_order
VECTOR_STATEMENT_TIMEOUT_MS=5000

# --- Retrieval: query budget and bulkhead ---
RETRIEVAL_DEADLINE_MS=15000
RETRIEVAL_MAX_CONCURRENCY=12
RETRIEVAL_QUEUE_LIMIT=200
RETRIEVAL_LEXICAL_TIMEOUT_MS=2000
# Preserve per-hop evidence and provide source-routing metadata to the answer model.
CHAT_STRUCTURED_EVIDENCE=true
# Optional deployment namespace; the code also carries a non-overridable schema salt.
SEMANTIC_CACHE_KEY_VERSION=release-2026-10-05
GRAPHRAG_DRIFT_ENABLED=true
GRAPHRAG_DRIFT_MAX_COMMUNITIES=2
GRAPHRAG_DRIFT_MAX_PROBES=2
# --- Object storage (MinIO / S3-compatible) ---
# All three of MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY must be set
# for storageProvider=minio; otherwise the API warns once and falls back to
# local disk (UPLOAD_ROOT). MINIO_USER/MINIO_PASS are the MinIO console root
# credentials (docker-compose), not the S3 API keys below.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change_me_to_a_minio_access_key
MINIO_SECRET_KEY=change_me_to_a_minio_secret_key
MINIO_BUCKET=llmwiki-raw
MINIO_REGION=us-east-1

# BGE-M3 sparse + ColBERT late-interaction arms; default ON (fail-open when the
# gateway returns dense only — retrieval_failopen_total tracks the degradation).
# Set BGE_M3_HYBRID_ENABLED=false to opt out. See docs/minio-embedding-runbook.md.
# (Authoritative default lives in the release-policy block below: false.)
BGE_M3_HYBRID_ENDPOINT=
BGE_M3_LATE_CHUNKING=false
BGE_M3_MULTI_VECTOR_MAX_TOKENS=128
RETRIEVAL_BGE_M3_SPARSE_RRF_WEIGHT=0.9
RETRIEVAL_BGE_M3_LATE_RRF_WEIGHT=1.0

# Default knowledge release policy (scripts/config/knowledge-quality-first.env)
# Shared release policy: accuracy before latency/token savings.
RETRIEVAL_QUALITY_PROFILE=quality-first
RLS_ENFORCE=0
CORE_AUTH_ENFORCE=1
CORE_VERSIONING_ENABLED=1
CORE_GRAPH_INCREMENTAL_ENABLED=1
ADAPTIVE_RETRIEVAL_ENABLED=true
# Current providers cannot supply these representations; user excluded them.
BGE_M3_HYBRID_ENABLED=false
BGE_M3_MAXSIM_ENABLED=false
BGE_M3_LATE_CHUNKING_ENABLED=false
ALLOW_UNVERSIONED_EMBEDDING_PUBLICATION=true

# --- Office preview conversion (ppt/pptx → cached pdf) ---
# Preferred path: resident unoserver listener (deploy/systemd/llmwiki-unoserver.service).
# The API calls `unoconvert` from PATH (or UNOSERVER_CONVERT_BIN); when the binary
# or listener is missing it falls back to a profile-isolated cold soffice call,
# which stays concurrency-safe via per-invocation UserInstallation profiles.
OFFICE_PREVIEW_UNOSERVER=1
UNOSERVER_HOST=127.0.0.1
UNOSERVER_PORT=2003
UNOSERVER_TIMEOUT_MS=60000
SOFFICE_TIMEOUT_MS=120000

# ---- P0-P2 优化开关（2026-10-03） ----
# 严格输出契约：整篇答案一次性下发；默认关闭。
KNOWLEDGE_STRICT_OUTPUT=0
# 增量流式总开关。默认 0 = 缓冲整篇后一次性下发（最终质量优先）。
# 置 1 = 生成过程中逐句下发已核验内容（首字更快），但接地门在流式之后
# 仍会丢弃/重排语句，此时服务端额外下发 replace 事件覆盖客户端内容。
KNOWLEDGE_INCREMENTAL_STREAM=0
# 语义缓存向量相似命中阈值（B-5；余弦相似 ≥ 阈值才算命中，0.96 起步）。
SEMANTIC_CACHE_SIMILARITY=0.96
# outbox 事件重试预算，超过即转 dead 死信（B-9；可经 /admin/outbox/:id/replay 重放）。
OUTBOX_MAX_RETRIES=10
# 自适应探针预算：主查询证据覆盖已足时跳过实体/子问题/关系级联探针（P1 体验-3）。
RETRIEVAL_ADAPTIVE_PROBES=1
# 图谱路由：auto=仅多跳类查询启用局部图谱探针；always/off 覆盖（P2-3）。
GRAPHRAG_ROUTE=auto
# 检索 arm shadow A/B：只计算影子排序一致性打点，不改变下发结果（P2-2）。
RETRIEVAL_ARM_SHADOW=0
