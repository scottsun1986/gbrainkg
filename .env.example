# ==========================================
# LLMWiki Environment Variables Example
# Copy this file to .env and change the values
# ==========================================

# ------------------------------------------
# Environment
# ------------------------------------------
# Set to 'production' for deployments, 'development' for local work
NODE_ENV=development

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DB_USER=llmwiki
DB_PASS=change_me_to_a_secure_password
DB_NAME=llmwiki
# Connection string for applications (match the credentials above)
DATABASE_URL=postgresql://llmwiki:change_me_to_a_secure_password@localhost:5433/llmwiki

# ------------------------------------------
# Redis Cache
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password is set, or set if configured in docker-compose
REDIS_PASS=change_me_to_a_redis_password

# ------------------------------------------
# Storage (MinIO)
# ------------------------------------------
MINIO_USER=admin
MINIO_PASS=change_me_to_a_secure_password123
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000

# ------------------------------------------
# Authentication
# ------------------------------------------
# JWT Secret Key - Generate a random 64-character string
# Example generation: openssl rand -hex 32
JWT_SECRET=generate_a_random_64_character_hex_string_here

# ------------------------------------------
# API & Web Server
# ------------------------------------------
# Port for the API server to listen on
PORT=3000
# Host to bind the API to
HOST=127.0.0.1
# Allowed origin for CORS (the URL of the web frontend)
WEB_ORIGIN=http://localhost:3001

# ------------------------------------------
# LiteLLM Gateway
# ------------------------------------------
# Master key to authenticate with LiteLLM proxy
LITELLM_MASTER_KEY=sk-llmwiki-master-key-change-me

# ------------------------------------------
# Parser Worker
# ------------------------------------------
# URL for the Python parser worker service
PARSER_URL=http://localhost:8100

# ------------------------------------------
# Model Defaults
# ------------------------------------------
# Default LLM configuration (points to LiteLLM by default)
DEFAULT_LLM_BASE_URL=http://localhost:4100
DEFAULT_LLM_API_KEY=sk-llmwiki-master-key-change-me
DEFAULT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------
# SOTA Retrieval Feature Flags (all optional)
# ------------------------------------------
# Agentic query decomposition + HyDE hypothetical document embeddings
AGENTIC_RAG_ENABLED=true
HYDE_ENABLED=true
# Always run the platform cross-encoder even if GBrain reports a native rerank
FORCE_PLATFORM_RERANK=true
# Hard cap for any single GBrain CLI query (ms); abort frees the process pool
GBRAIN_QUERY_HARD_TIMEOUT_MS=20000
# Bound the DB chunk fallback expansion (memory safety)
RETRIEVAL_MAX_EXPAND_DOCS=8
RETRIEVAL_MAX_DOC_CHUNKS=3000
# RAPTOR recursive summary tree (macro-level recall; uses LLM when indexing)
RAPTOR_ENABLED=false
RAPTOR_USE_LLM=true
# Incremental knowledge-graph extraction on publish (LLM cost; off by default)
AUTO_GRAPH_EXTRACT_ENABLED=false
# Semantic cache scope isolation is always on; tune similarity/TTL here
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY=0.96
SEMANTIC_CACHE_TTL_HOURS=24

# ------------------------------------------
# SOTA Quality Gate Thresholds (tests/evaluation)
# ------------------------------------------
GATE_HIT_RATE=0.90
GATE_KEYWORD_COVERAGE=0.85
GATE_PERMISSION_RATE=1.00
GATE_NO_HALLUCINATION=0.95
GATE_FAITHFULNESS=0.95
GATE_CITATION_ACCURACY=0.90
GATE_CONTEXT_PRECISION=0.85

# ------------------------------------------
# Chunk-level semantic retrieval (pgvector)
# ------------------------------------------
# Populate Chunk.embedding and use the vector arm in retrieval.
CHUNK_EMBEDDINGS_ENABLED=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=6000
EMBEDDING_TIMEOUT_MS=20000
CHUNK_EMBEDDING_WRITE_BATCH=64
# Minimum cosine similarity for a vector hit to enter the candidate set
VECTOR_MIN_SCORE=0.30
# Weight applied to cosine similarity when fusing with keyword scores
VECTOR_SCORE_WEIGHT=30
# LLM query expansion (general, corpus-agnostic; replaces hardcoded synonyms)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_TOKENS=1200
QUERY_EXPANSION_TIMEOUT_MS=10000
# Bump to invalidate all semantic-cache entries after retrieval changes
SEMANTIC_CACHE_KEY_VERSION=v2

# ------------------------------------------
# Workflow hardening (2026-09-10 assessment)
# ------------------------------------------
# Knowledge graph API: bounded GBrain link discovery + response cache
KG_MAX_CHUNKS_PER_DOC=40
KG_CACHE_TTL_MS=300000
KG_LINK_BUDGET_MS=8000
KG_LINK_CONCURRENCY=4
KG_LINK_MAX_DOCS=40
# Durable post-publish enrichment queue + index readiness state machine
ENRICHMENT_CONCURRENCY=2
ENRICHMENT_ATTEMPTS=3
ENRICHMENT_BACKOFF_MS=30000
# Semantic coverage: LLM entailment judge for low-coverage answers (fail-open)
SEMANTIC_COVERAGE_JUDGE=true
SEMANTIC_COVERAGE_TIMEOUT_MS=15000
SEMANTIC_COVERAGE_MAX_TOKENS=1200
# RAPTOR is enabled by default; set false to disable macro summary indexing
RAPTOR_ENABLED=true
