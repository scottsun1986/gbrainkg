# ==========================================
# LLMWiki Environment Variables Example
# Copy this file to .env and change the values
# ==========================================

# ------------------------------------------
# Environment
# ------------------------------------------
# Set to 'production' for deployments, 'development' for local work
NODE_ENV=development

# ------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------
DB_USER=llmwiki
DB_PASS=change_me_to_a_secure_password
DB_NAME=llmwiki
# Connection string for applications (match the credentials above)
# Migration / GBrain role keeps BYPASSRLS.
DATABASE_URL=postgresql://llmwiki:change_me_to_a_secure_password@localhost:5433/llmwiki

# Runtime role (NOBYPASSRLS) for request-path queries so RLS tenant isolation
# is actually enforced. Create with:
#   CREATE USER llmwiki_app WITH PASSWORD '<unique>' NOBYPASSRLS;
#   GRANT CONNECT ON DATABASE llmwiki TO llmwiki_app;
#   GRANT USAGE,CREATE ON SCHEMA public TO llmwiki_app;
#   GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO llmwiki_app;
#   GRANT USAGE,SELECT ON ALL SEQUENCES IN SCHEMA public TO llmwiki_app;
DB_USER_APP=llmwiki_app
DB_PASS_APP=change_me_to_a_different_secure_app_password
DATABASE_URL_APP=postgresql://llmwiki_app:change_me_to_a_different_secure_app_password@localhost:5433/llmwiki

# RLS_ENFORCE=1: every Prisma operation uses transaction-local user/service
# context. API startup rejects a BYPASSRLS role or an app.service=on default.
# Requires DATABASE_URL_APP; jobs without HTTP request context use service scope.
RLS_ENFORCE=1

# ------------------------------------------
# Redis Cache
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password is set, or set if configured in docker-compose
REDIS_PASS=change_me_to_a_redis_password

# ------------------------------------------
# Storage (MinIO)
# ------------------------------------------
# Placeholders only — replace before use and never commit real credentials.
MINIO_USER=admin
MINIO_PASS=change_me_to_a_secure_password123
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=change_me_to_a_minio_access_key
MINIO_SECRET_KEY=change_me_to_a_minio_secret_key
MINIO_BUCKET=llmwiki-raw
MINIO_REGION=us-east-1

# ------------------------------------------
# Authentication
# ------------------------------------------
# JWT Secret Key - Generate a random 64-character string
# Example generation: openssl rand -hex 32
JWT_SECRET=generate_a_random_64_character_hex_string_here

# ------------------------------------------
# API & Web Server
# ------------------------------------------
# Port for the API server to listen on
PORT=3000
# Host to bind the API to
HOST=127.0.0.1
# Allowed origin for CORS (the URL of the web frontend)
WEB_ORIGIN=http://localhost:3001

# ------------------------------------------
# LiteLLM Gateway
# ------------------------------------------
# Master key to authenticate with LiteLLM proxy
LITELLM_MASTER_KEY=sk-llmwiki-master-key-change-me

# ------------------------------------------
# Parser Worker
# ------------------------------------------
# URL for the Python parser worker service
PARSER_URL=http://localhost:8100

# ------------------------------------------
# Model Defaults
# ------------------------------------------
# Default LLM configuration (points to LiteLLM by default)
DEFAULT_LLM_BASE_URL=http://localhost:4100
DEFAULT_LLM_API_KEY=sk-llmwiki-master-key-change-me
DEFAULT_LLM_MODEL=gpt-4o-mini

# ------------------------------------------
# SOTA Retrieval Feature Flags (all optional)
# ------------------------------------------
# Agentic query decomposition + HyDE hypothetical document embeddings
AGENTIC_RAG_ENABLED=true
HYDE_ENABLED=true
# Always run the platform cross-encoder even if GBrain reports a native rerank
# (authoritative entry: see the retrieval-chain section below, default false)
# Hard cap for any single GBrain CLI query (ms); abort frees the process pool
GBRAIN_QUERY_HARD_TIMEOUT_MS=20000
# Bound the DB chunk fallback expansion (memory safety)
RETRIEVAL_MAX_EXPAND_DOCS=8
RETRIEVAL_MAX_DOC_CHUNKS=3000
# RAPTOR recursive summary tree (macro-level recall; uses LLM when indexing)
# Default ON in code (raptor.service.ts); the single authoritative entry lives
# in the release-policy block below.
# RAPTOR_USE_LLM=true
# Incremental knowledge-graph extraction on publish (LLM cost; off by default)
AUTO_GRAPH_EXTRACT_ENABLED=false
# Semantic cache scope isolation is always on; tune similarity/TTL here
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY=0.96
SEMANTIC_CACHE_TTL_HOURS=24

# ------------------------------------------
# SOTA Quality Gate Thresholds (tests/evaluation)
# ------------------------------------------
GATE_HIT_RATE=0.90
GATE_KEYWORD_COVERAGE=0.85
GATE_PERMISSION_RATE=1.00
GATE_NO_HALLUCINATION=0.95
GATE_FAITHFULNESS=0.95
GATE_CITATION_ACCURACY=0.90
GATE_CONTEXT_PRECISION=0.85

# ------------------------------------------
# Chunk-level semantic retrieval (pgvector)
# ------------------------------------------
# Populate Chunk.embedding and use the vector arm in retrieval.
CHUNK_EMBEDDINGS_ENABLED=true
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CHARS=6000
EMBEDDING_TIMEOUT_MS=20000
CHUNK_EMBEDDING_WRITE_BATCH=64
# Minimum cosine similarity for a vector hit to enter the candidate set
VECTOR_MIN_SCORE=0.30
# Weight applied to cosine similarity when fusing with keyword scores
VECTOR_SCORE_WEIGHT=30
# LLM query expansion (general, corpus-agnostic; replaces hardcoded synonyms)
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_TOKENS=1200
QUERY_EXPANSION_TIMEOUT_MS=10000
# Bump to invalidate all semantic-cache entries after retrieval changes
SEMANTIC_CACHE_KEY_VERSION=release-2026-10-05

# ------------------------------------------
# Workflow hardening (2026-09-10 assessment)
# ------------------------------------------
# Knowledge graph API: bounded GBrain link discovery + response cache
KG_MAX_CHUNKS_PER_DOC=40
KG_CACHE_TTL_MS=300000
KG_LINK_BUDGET_MS=8000
KG_LINK_CONCURRENCY=4
KG_LINK_MAX_DOCS=40
# Durable post-publish enrichment queue + index readiness state machine
ENRICHMENT_CONCURRENCY=4
# LLM-based RAPTOR/graph work has a separate pool so slow calls cannot block dense/BM25.
AUX_ENRICHMENT_CONCURRENCY=2
# Bound Redis waiting jobs; the database outbox retains overflow durably.
ENRICHMENT_QUEUE_MAX_WAITING=500
AUX_ENRICHMENT_QUEUE_MAX_WAITING=100
ENRICHMENT_ATTEMPTS=3
ENRICHMENT_BACKOFF_MS=30000
# Semantic coverage: LLM entailment judge for low-coverage answers (fail-open)
SEMANTIC_COVERAGE_JUDGE=true
SEMANTIC_COVERAGE_TIMEOUT_MS=15000
SEMANTIC_COVERAGE_MAX_TOKENS=1200
# RAPTOR is enabled by default; set false to disable macro summary indexing
RAPTOR_ENABLED=true

# ------------------------------------------
# Retrieval chain optimization (2026-09-10 P0/P1/P2)
# ------------------------------------------
# Candidate cap BEFORE the platform cross-encoder (final cut happens after)
GBRAIN_MERGE_CAP_FOCUSED=30
GBRAIN_MERGE_CAP_BREADTH=60
# Single evidence-selection stage
RETRIEVAL_CONTEXT_TOKEN_BUDGET=12000
# Rigid relative relevance floor (share of the best group's score). This is the
# DEFAULT behaviour. The loosened 0.22 set (quantile-smoothed baseline, 6
# guaranteed groups, capped synthetic fill) ships behind the flag below and is
# OFF until the A/B gate proves it (review 2026-10-05, P1-5).
RETRIEVAL_RELEVANCE_FLOOR_RATIO=0.35
RETRIEVAL_SOFT_FLOOR_ENABLED=false
# Guaranteed top-M groups by measured score that clear minimal viable
# relevance (only with RETRIEVAL_SOFT_FLOOR_ENABLED=true; 0 disables)
#RETRIEVAL_MIN_FLOOR_GROUPS=6
#RETRIEVAL_MIN_VIABLE_RELEVANCE=0.10
# Max synthetic (never cross-encoded) groups filling leftover context slots
# (only with RETRIEVAL_SOFT_FLOOR_ENABLED=true; 0 disables)
#RETRIEVAL_SYNTHETIC_FILL_MAX=2
# Multi-source coverage ratio (review §3.3): a different document whose best
# group scores at least this share of the best group and discusses the same
# topic keeps one representative (only with RETRIEVAL_SOFT_FLOOR_ENABLED=true)
#RETRIEVAL_MULTISOURCE_COVERAGE_RATIO=0.35
# Elimination-funnel records kept in the evidenceSelection trace (id-only)
#RETRIEVAL_ELIMINATION_TRACE_MAX=12
RETRIEVAL_MAX_GROUPS=8
RETRIEVAL_MAX_GROUPS_BREADTH=16
RETRIEVAL_MMR_LAMBDA=0.72
# Maximum character length per evidence chunk in chat prompt (default 6000, preserves tables and dense content)
CHAT_CHUNK_MAX_CHARS=6000
# Keep one representative from each planned sub-question/bridge near the front
# of multi-hop answer context and emit a source-routing map for the generator.
CHAT_STRUCTURED_EVIDENCE=true
# Community summaries navigate retrieval only; final facts must resolve to source chunks.
GRAPHRAG_DRIFT_ENABLED=true
GRAPHRAG_DRIFT_MAX_COMMUNITIES=2
GRAPHRAG_DRIFT_MAX_PROBES=2
# BGE-M3 sparse + ColBERT arms (fail-open when the gateway returns dense
# only). Set true to opt out. See docs/minino-embedding-runbook.md.
# (Authoritative default lives in the release-policy block below: false.)
BGE_M3_HYBRID_ENDPOINT=
BGE_M3_LATE_CHUNKING=false
BGE_M3_MULTI_VECTOR_MAX_TOKENS=128
RETRIEVAL_BGE_M3_SPARSE_RRF_WEIGHT=0.9
RETRIEVAL_BGE_M3_LATE_RRF_WEIGHT=1.0
# Platform cross-encoder
RERANK_TIMEOUT_MS=15000
RERANK_CACHE_TTL_MS=300000
# Cross-encoder capacity (review P1-6: 100 raised whole-batch timeout risk; the
# cascade coarse stage keeps every probe channel's heads, so 60 suffices)
RERANK_MAX_DOCS=60
# Two-stage cascade coarse stage (review §3.2): channel-head preservation
# instead of a plain head slice; set false to restore the plain slice.
RERANK_CASCADE_ENABLED=true
#RERANK_CASCADE_CHANNEL_HEADS=3
# Set true to always run the platform reranker even on single-source native results
FORCE_PLATFORM_RERANK=false

# RAPTOR indexing bounds (prevent huge docs from stalling the queue)
RAPTOR_MAX_CHUNKS=300
RAPTOR_MAX_GROUPS=40

# Default knowledge release policy (scripts/config/knowledge-quality-first.env)
# Shared release policy: accuracy before latency/token savings.
RETRIEVAL_QUALITY_PROFILE=quality-first
CORE_AUTH_ENFORCE=1
CORE_VERSIONING_ENABLED=1
CORE_GRAPH_INCREMENTAL_ENABLED=1
ADAPTIVE_RETRIEVAL_ENABLED=true
# Current providers cannot supply these representations; user excluded them.
BGE_M3_HYBRID_ENABLED=false
BGE_M3_MAXSIM_ENABLED=false
BGE_M3_LATE_CHUNKING_ENABLED=false
ALLOW_UNVERSIONED_EMBEDDING_PUBLICATION=true
